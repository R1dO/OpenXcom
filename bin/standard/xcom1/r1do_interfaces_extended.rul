interfaces:
  - type: baseInfoDetails
    backgroundImage: BACK13.SCR
    palette: PAL_BASESCAPE
    elements:
      - id: palette
        color: 6     # oxide
      - id: window
        color: 246   # purple
      - id: button
        color: 246   # purple
      - id: text
        color: 246   # purple
        color2: 208   # white
      - id: list
        color: 218   # blue
        color2: 208  # white
  - type: buildFacilitiesDetails
    backgroundImage: BACK05.SCR
    palette: PAL_BASESCAPE
    elements:
      - id: palette
        color: 6     # oxide
      - id: window
        color: 246   # purple
      - id: button
        color: 246   # purple
      - id: text
        color: 246   # purple
        color2: 208   # white
      - id: list
        color: 218   # blue
        color2: 208  # white. For subcategory lines (parents)
        border: 246
      - id: list-highlight
        color:  213  # yellow. For description highlights